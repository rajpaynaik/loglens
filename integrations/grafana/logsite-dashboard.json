{
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Timeseries",
      "version": ""
    },
    {
      "type": "panel",
      "id": "logs",
      "name": "Logs",
      "version": ""
    },
    {
      "type": "panel",
      "id": "text",
      "name": "Text",
      "version": ""
    }
  ],
  "description": "Log cost and errors per code line (file:line) from Loki. Made by logsite: https://github.com/rajpaynaik/logsite",
  "title": "Log cost per code line (logsite)",
  "uid": "logsite-log-cost",
  "tags": [
    "logsite",
    "logs",
    "cost"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {}
      },
      {
        "name": "selector",
        "label": "Stream selector",
        "description": "LogQL stream selector",
        "type": "textbox",
        "query": "{service_name=~\".+\"}",
        "current": {
          "text": "{service_name=~\".+\"}",
          "value": "{service_name=~\".+\"}"
        }
      },
      {
        "name": "parser",
        "label": "Parser",
        "type": "custom",
        "query": "json,logfmt",
        "current": {
          "text": "json",
          "value": "json"
        },
        "options": [
          {
            "text": "json",
            "value": "json",
            "selected": true
          },
          {
            "text": "logfmt",
            "value": "logfmt",
            "selected": false
          }
        ]
      },
      {
        "name": "file_field",
        "label": "File field",
        "description": "Field with the source file",
        "type": "textbox",
        "query": "pathname",
        "current": {
          "text": "pathname",
          "value": "pathname"
        }
      },
      {
        "name": "line_field",
        "label": "Line field",
        "description": "Field with the line number",
        "type": "textbox",
        "query": "lineno",
        "current": {
          "text": "lineno",
          "value": "lineno"
        }
      },
      {
        "name": "level_field",
        "label": "Level field",
        "description": "Field with the log level",
        "type": "textbox",
        "query": "level",
        "current": {
          "text": "level",
          "value": "level"
        }
      },
      {
        "name": "path_prefix",
        "label": "Strip prefix",
        "description": "Deployed path prefix, e.g. /srv/",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "repo_url",
        "label": "Code URL",
        "description": "Links rows to the code, e.g. https://github.com/org/repo/blob/main",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "price_per_gb",
        "label": "Price per GB ($)",
        "type": "textbox",
        "query": "0.5",
        "current": {
          "text": "0.5",
          "value": "0.5"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 9,
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Log cost per code line.** Every row is one log call (`file:line`), most expensive first, read live from Loki. Set the variables above to how your records look: the stream `selector`, the parser, and the fields that hold the file, line and level (Python logging: `pathname`, `lineno`, `levelname`). Records need file and line fields.\n\n[logsite](https://github.com/rajpaynaik/logsite) (open source) generates this dashboard for your own code: each row shows its log message and links to the line, plus Alloy rules that drop or sample the expensive lines, and checks in the editor and in CI."
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Log volume",
      "description": "Bytes stored in the selected time range.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum(bytes_over_time(${selector} [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Log lines",
      "description": "Lines stored in the selected time range.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum(count_over_time(${selector} [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Estimated cost / month",
      "description": "The selected range's volume scaled to 30 days, at the price per GB set above.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum(bytes_over_time(${selector} [$__range])) * 2592000 / $__range_s / 1000000000 * $price_per_gb",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error lines",
      "description": "Lines whose ${level_field} is error, critical or fatal.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum(count_over_time(${selector} | ${parser} | __error__=`` | ${level_field}=~\"(?i)(error|err|critical|crit|fatal|exception|alert|emergency)\" [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Cost by code line",
      "description": "Every log call by what it writes, most expensive first. Click a row's log call to open it in the code. Generated by logsite from the code: regenerate after big changes so new log calls show their message.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "cost",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (logsite_site, logsite_file, logsite_line) (bytes_over_time(${selector} | ${parser} | __error__=`` | ${file_field}!=`` | ${line_field}!=`` | label_format logsite_file=`{{ trimPrefix \"${path_prefix}\" .${file_field} }}`, logsite_line=`{{ .${line_field} }}`, logsite_site=`{{ trimPrefix \"${path_prefix}\" .${file_field} }}:{{ .${line_field} }}` [$__range])) * 2592000 / $__range_s / 1000000000 * $price_per_gb",
          "queryType": "instant",
          "instant": true,
          "range": false
        },
        {
          "refId": "bytes",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (logsite_site, logsite_file, logsite_line) (bytes_over_time(${selector} | ${parser} | __error__=`` | ${file_field}!=`` | ${line_field}!=`` | label_format logsite_file=`{{ trimPrefix \"${path_prefix}\" .${file_field} }}`, logsite_line=`{{ .${line_field} }}`, logsite_site=`{{ trimPrefix \"${path_prefix}\" .${file_field} }}:{{ .${line_field} }}` [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false
        },
        {
          "refId": "lines",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (logsite_site, logsite_file, logsite_line) (count_over_time(${selector} | ${parser} | __error__=`` | ${file_field}!=`` | ${line_field}!=`` | label_format logsite_file=`{{ trimPrefix \"${path_prefix}\" .${file_field} }}`, logsite_line=`{{ .${line_field} }}`, logsite_site=`{{ trimPrefix \"${path_prefix}\" .${file_field} }}:{{ .${line_field} }}` [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value #cost",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "logsite_site"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Log call"
              },
              {
                "id": "mappings",
                "value": []
              },
              {
                "id": "custom.width",
                "value": 560
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open the log call",
                    "url": "${repo_url}/${__data.fields.logsite_file}#L${__data.fields.logsite_line}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "logsite_file"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "logsite_line"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #cost"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Est. / month"
              },
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #bytes"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Volume in range"
              },
              {
                "id": "unit",
                "value": "decbytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #lines"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Lines in range"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Errors by code line",
      "description": "Error-level lines per log call now and in the same range just before, to spot what started failing. `logsite errors` groups them by cause.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "now",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (logsite_site, logsite_file, logsite_line) (count_over_time(${selector} | ${parser} | __error__=`` | ${file_field}!=`` | ${line_field}!=`` | label_format logsite_file=`{{ trimPrefix \"${path_prefix}\" .${file_field} }}`, logsite_line=`{{ .${line_field} }}`, logsite_site=`{{ trimPrefix \"${path_prefix}\" .${file_field} }}:{{ .${line_field} }}` | ${level_field}=~\"(?i)(error|err|critical|crit|fatal|exception|alert|emergency)\" [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false
        },
        {
          "refId": "before",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (logsite_site, logsite_file, logsite_line) (count_over_time(${selector} | ${parser} | __error__=`` | ${file_field}!=`` | ${line_field}!=`` | label_format logsite_file=`{{ trimPrefix \"${path_prefix}\" .${file_field} }}`, logsite_line=`{{ .${line_field} }}`, logsite_site=`{{ trimPrefix \"${path_prefix}\" .${file_field} }}:{{ .${line_field} }}` | ${level_field}=~\"(?i)(error|err|critical|crit|fatal|exception|alert|emergency)\" [$__range] offset $__range))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value #now",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "logsite_site"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Log call"
              },
              {
                "id": "mappings",
                "value": []
              },
              {
                "id": "custom.width",
                "value": 340
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open the log call",
                    "url": "${repo_url}/${__data.fields.logsite_file}#L${__data.fields.logsite_line}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "logsite_file"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "logsite_line"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #now"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Errors in range"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #before"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Range before"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Loudest log calls",
      "description": "Bytes per second written by the 10 loudest log calls.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "topk(10, sum by (logsite_site) (bytes_rate(${selector} | ${parser} | __error__=`` | ${file_field}!=`` | ${line_field}!=`` | label_format logsite_file=`{{ trimPrefix \"${path_prefix}\" .${file_field} }}`, logsite_line=`{{ .${line_field} }}`, logsite_site=`{{ trimPrefix \"${path_prefix}\" .${file_field} }}:{{ .${line_field} }}` [$__auto])))",
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "{{logsite_site}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Recent errors",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "${selector} | ${parser} | __error__=`` | ${level_field}=~\"(?i)(error|err|critical|crit|fatal|exception|alert|emergency)\"",
          "queryType": "range",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
